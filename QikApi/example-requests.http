# Generate Documents - Web API Controller
POST https://localhost:5001/api/qik/generate
Content-Type: application/json

{
  "script": "@entityName => \"Product\"; @baseUrl => \"api/@{pluralName}\"; @pluralName => lowerCase(@entityName) + \"s\";",
  "fragments": {
    "controllerHeader": "using Microsoft.AspNetCore.Mvc;\n\nnamespace @{namespace}.Controllers;\n\n[ApiController]\n[Route(\\\"@{baseUrl}\\\")]\npublic class @{entityName}Controller : ControllerBase\n{\n",
    "getMethod": "    [HttpGet]\n    public IActionResult GetAll()\n    {\n        return Ok(\\\"Get all @{entityName} items\\\");\n    }\n\n    [HttpGet(\\\"{ id}\\\")]\n    public IActionResult GetById(int id)\n    {\n        return Ok($\\\"Get @{entityName} with id: {id}\\\");\n    }\n\n",
    "controllerFooter": "}"
  },
  "documents": {
    "src/controllers/@{entityName}Controller.cs": "{controllerHeader}{getMethod}{controllerFooter}"
  },
  "inputs": {
    "@entityName": "Order",
    "@namespace": "ECommerceApi"
  },
  "placeholderPrefix": "@{",
  "placeholderSuffix": "}"
}

###

# Generate Documents - Configuration Files
POST https://localhost:5001/api/qik/generate
Content-Type: application/json

{
  "script": "@appName => \"MyApp\"; @environment => \"Development\"; @databaseName => @appName + \"DB\";",
  "fragments": {
    "appSettings": "{\n  \\\"Logging\\\": {\n    \\\"LogLevel\\\": {\n      \\\"Default\\\": \\\"Information\\\"\n    }\n  },\n  \\\"ApplicationSettings\\\": {\n    \\\"AppName\\\": \\\"@{appName}\\\",\n    \\\"Environment\\\": \\\"@{environment}\\\",\n    \\\"DatabaseName\\\": \\\"@{databaseName}\\\"\n  }\n}",
    "dockerFile": "FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base\nWORKDIR /app\nEXPOSE 3000\n\nFROM mcr.microsoft.com/dotnet/sdk:9.0 AS build\nWORKDIR /src\nCOPY *.csproj ./\nRUN dotnet restore\nCOPY . ./\nRUN dotnet publish -c Release -o /app\n\nFROM base\nWORKDIR /app\nCOPY --from=build /app .\n\n# Application: @{appName}\nENTRYPOINT [\\\"dotnet\\\", \\\"@{appName}.dll\\\"]"
  },
  "documents": {
    "appsettings.json": "{appSettings}",
    "Dockerfile": "{dockerFile}"
  },
  "inputs": {
    "@appName": "TaskManager",
    "@environment": "Production"
  },
  "placeholderPrefix": "@{",
  "placeholderSuffix": "}"
}
# =============================
# Qik API Example Requests
# =============================

# Example API Requests for Qik API

## Health Check
GET https://localhost:5001/api/qik/health

###

## Get Available Functions
GET https://localhost:5001/api/qik/functions

###


# Interpret Simple Script (plain text)
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@name => \"John Doe\"; @greeting => \"Hello, \" + @name + \"!\";"
}

###

# Interpret Simple Script (Base64)
POST https://localhost:5001/api/qik/interpret?contentEncoding=base64
Content-Type: application/json

{
  "script": "QG5hbWUgPT4gXCJKb2huIERvZVwiOyBAbmFtZSA9PiBcIkhlbGxvLCBcIiArIEBuYW1lICsgXCIhXCI7"
}

###

## Interpret with Variable Override
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@name => \"John\"; @greeting => \"Hello, \" + @name;",
  "variables": {
    "@name": "Alice"
  }
}

###

## Code Generation Example
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@className => \"UserService\"; @namespace => \"MyApp.Services\"; @property => camelCase(@className) + \"Instance\";"
}

###


# Extract UI Widgets (plain text)
POST https://localhost:5001/api/qik/widgets
Content-Type: application/json

{
  "script": "[title = \"User Name\", type = \"text\"] @userName => \"Guest\"; [title = \"Email Address\", type = \"email\"] @email => \"user@example.com\";"
}

###

# Extract UI Widgets (Base64)
POST https://localhost:5001/api/qik/widgets?contentEncoding=base64
Content-Type: application/json

{
  "script": "W3RpdGxlID0gXCJVc2VyIE5hbWVcIiwgdHlwZSA9IFwidGV4dFwiXSBAdXNlck5hbWUgPT4gXCJHdWVzdFwiOyBbdGl0bGUgPSBcIkVtYWlsIEFkZHJlc3NcIiwgdHlwZSA9IFwiZW1haWxcIl0gQGVtYWlsID0+IFwidXNlckBleGFtcGxlLmNvbVwiOyI=
}
# Add: Generate Documents (plain text)
POST https://localhost:5001/api/qik/generate
Content-Type: application/json

{
  "script": "@className => \"User\"; @namespace => \"MyApp.Models\";",
  "fragments": {
    "classTemplate": "namespace @{namespace};\n\npublic class @{className}\n{\n}\n"
  },
  "documents": {
    "models/User.cs": "{classTemplate}"
  },
  "placeholderPrefix": "@{",
  "placeholderSuffix": "}"
}

###

# Generate Documents (Base64)
POST https://localhost:5001/api/qik/generate?contentEncoding=base64
Content-Type: application/json

{
  "script": "QGNsYXNzTmFtZSA9PiAiVXNlciI7IEBuYW1lc3BhY2UgPT4gIk15QXBwLk1vZGVscyI7",
  "fragments": {
    "classTemplate": "bmFtZXNwYWNlIEB7bmFtZXNwYWNlfTtcblxucHVibGljIGNsYXNzIEB7Y2xhc3NOYW1lfVxue1xufQ=="
  },
  "documents": {
    "models/User.cs": "{classTemplate}"
  },
  "placeholderPrefix": "@{",
  "placeholderSuffix": "}"
}

###

## Evaluate Expression - Text Transformation
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "upperCase(@name)",
  "context": {
    "@name": "john doe"
  }
}

###

## Evaluate Expression - Multiple Functions
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "camelCase(replace(@input, \" \", \"_\"))",
  "context": {
    "@input": "Hello World Example"
  }
}

###

## Evaluate Expression - Date Formatting
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "currentDate(\"yyyy-MM-dd\")"
}

###

## Evaluate Expression - GUID Generation
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "guid(\"u\")"
}

###

## Evaluate Expression - Conditional (Ternary)
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "@count == \"0\" ? \"empty\" : \"has items\"",
  "context": {
    "@count": "5"
  }
}

###

## Complex Script - URL Builder
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@baseUrl => \"https://api.example.com\"; @endpoint => \"users/search\"; @query => \"john doe\"; @encodedQuery => urlEncode(@query); @fullUrl => @baseUrl + \"/\" + @endpoint + \"?q=\" + @encodedQuery;"
}

###

## Complex Script - HTML Generator
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@title => \"Welcome\"; @content => \"Hello World\"; @html => \"<!DOCTYPE html>\" + NEWLINE + \"<html>\" + NEWLINE + indentLine(\"<title>\" + htmlEncode(@title) + \"</title>\", TAB, 1) + NEWLINE + \"</html>\";"
}

###

## Complex Script - Conditional Logic
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@score => \"B\"; @color => if @score == \"A\" then \"green\" else if @score == \"B\" then \"yellow\" else \"red\";"
}

###

## Complex Script - Switch Statement
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@day => \"Saturday\"; @dayType => switch @day case \"Saturday\" then \"Weekend\" case \"Sunday\" then \"Weekend\" else \"Weekday\";"
}

###


# Encoding/Decoding - Base64 (plain text)
POST https://localhost:5001/api/qik/interpret
Content-Type: application/json

{
  "script": "@original => \"Hello World\"; @encoded => base64Encode(@original); @decoded => base64Decode(@encoded);"
}

###

# Encoding/Decoding - Base64 (Base64 input)
POST https://localhost:5001/api/qik/interpret?contentEncoding=base64
Content-Type: application/json

{
  "script": "QG9yaWdpbmFsID0+IFwiSGVsbG8gV29ybGRcIjsgQGVuY29kZWQgPT4gYmFzZTY0RW5jb2RlKEBvcmlnaW5hbCk7IEBkZWNvZGVkID0+IGJhc2U2NERlY29kZShAZW5jb2RlZCk7"
}

###

## Text Transformation Chain
POST https://localhost:5001/api/qik/evaluate
Content-Type: application/json

{
  "expression": "upperCase(camelCase(@input))",
  "context": {
    "@input": "hello world example"
  }
}

