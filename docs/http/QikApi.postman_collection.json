    {
      "name": "Generate Documents - Web API Controller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"script\": \"@entityName => \\\"Product\\\"; @baseUrl => \\\"api/@{pluralName}\\\"; @pluralName => lowerCase(@entityName) + \\\"s\\\";\",\n  \"fragments\": {\n    \"controllerHeader\": \"using Microsoft.AspNetCore.Mvc;\\n\\nnamespace @{namespace}.Controllers;\\n\\n[ApiController]\\n[Route(\\\\\\\"@{baseUrl}\\\\\\\")]\\npublic class @{entityName}Controller : ControllerBase\\n{\\n\",\n    \"getMethod\": \"    [HttpGet]\\n    public IActionResult GetAll()\\n    {\\n        return Ok(\\\\\\\"Get all @{entityName} items\\\\\\\");\\n    }\\n\\n    [HttpGet(\\\\\\\"{ id}\\\\\\\")]\\n    public IActionResult GetById(int id)\\n    {\\n        return Ok($\\\\\\\"Get @{entityName} with id: {id}\\\\\\\");\\n    }\\n\\n\",\n    \"controllerFooter\": \"}\"\n  },\n  \"documents\": {\n    \"src/controllers/@{entityName}Controller.cs\": \"{controllerHeader}{getMethod}{controllerFooter}\"\n  },\n  \"inputs\": {\n    \"@entityName\": \"Order\",\n    \"@namespace\": \"ECommerceApi\"\n  },\n  \"placeholderPrefix\": \"@{\",\n  \"placeholderSuffix\": \"}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/qik/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "qik", "generate"]
        }
      }
