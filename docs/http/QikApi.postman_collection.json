    {
      "name": "Generate Documents - Configuration Files",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"script\": \"@appName => \\\"MyApp\\\"; @environment => \\\"Development\\\"; @databaseName => @appName + \\\"DB\\\";\",\n  \"fragments\": {\n    \"appSettings\": \"{\\n  \\\\\\\"Logging\\\\\\\": {\\n    \\\\\\\"LogLevel\\\\\\\": {\\n      \\\\\\\"Default\\\\\\\": \\\\\\\"Information\\\\\\\"\\n    }\\n  },\\n  \\\\\\\"ApplicationSettings\\\\\\\": {\\n    \\\\\\\"AppName\\\\\\\": \\\\\\\"@{appName}\\\\\\\",\\n    \\\\\\\"Environment\\\\\\\": \\\\\\\"@{environment}\\\\\\\",\\n    \\\\\\\"DatabaseName\\\\\\\": \\\\\\\"@{databaseName}\\\\\\\"\\n  }\\n}\",\n    \"dockerFile\": \"FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base\\nWORKDIR /app\\nEXPOSE 3000\\n\\nFROM mcr.microsoft.com/dotnet/sdk:9.0 AS build\\nWORKDIR /src\\nCOPY *.csproj ./\\nRUN dotnet restore\\nCOPY . ./\\nRUN dotnet publish -c Release -o /app\\n\\nFROM base\\nWORKDIR /app\\nCOPY --from=build /app .\\n\\n# Application: @{appName}\\nENTRYPOINT [\\\\\\\"dotnet\\\\\\\", \\\\\\\"@{appName}.dll\\\\\\\"]\"\n  },\n  \"documents\": {\n    \"appsettings.json\": \"{appSettings}\",\n    \"Dockerfile\": \"{dockerFile}\"\n  },\n  \"inputs\": {\n    \"@appName\": \"TaskManager\",\n    \"@environment\": \"Production\"\n  },\n  \"placeholderPrefix\": \"@{\",\n  \"placeholderSuffix\": \"}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/qik/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "qik", "generate"]
        }
      }
    }
