    {
      "name": "Generate Documents - Simple Class",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"script\": \"@className => \\\"User\\\"; @namespace => \\\"MyApp.Models\\\";\",\n  \"fragments\": {\n    \"classTemplate\": \"namespace @{namespace};\\n\\npublic class @{className}\\n{\\n}\",\n    \"interfaceTemplate\": \"namespace @{namespace};\\n\\npublic interface I@{className}\\n{\\n}\"\n  },\n  \"documents\": {\n    \"src/models/User.cs\": \"{classTemplate}\",\n    \"src/interfaces/IUser.cs\": \"{interfaceTemplate}\"\n  },\n  \"inputs\": {\n    \"@className\": \"Customer\",\n    \"@namespace\": \"MyApp.Domain\"\n  },\n  \"placeholderPrefix\": \"@{\",\n  \"placeholderSuffix\": \"}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/qik/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "qik", "generate"]
        }
      }
